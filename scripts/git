#!/usr/bin/env bash
# Agent-facing git entry point.
#
# Git here is the nix-built one, not /usr/bin/git, which on this machine is the
# Apple/Xcode build. This hands over to the nix-built git the dev shell supplies
# and passes every argument through untouched, so the version stays pinned even
# when the shell is stale.
#
# Call ./scripts/git instead of `git`. Override the binary with FLOR_DO_MAR_GIT
# when the store path below is collected or you want a different git.
set -euo pipefail
default_git=/nix/store/304vhl9qr5774qkv5rrqa0xbg429j2kk-git-2.55.0/bin/git
real_git="${FLOR_DO_MAR_GIT:-$default_git}"
if [ ! -x "$real_git" ]; then
  echo "scripts/git: $real_git is gone; re-run 'ls -d /nix/store/*git-*/bin/git' and set FLOR_DO_MAR_GIT" >&2
  exit 127
fi
exec "$real_git" "$@"
