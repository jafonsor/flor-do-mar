cabal-version: 3.8
name:          flor-do-mar
version:       0.1.0.0
synopsis:      Tactical naval combat prototype
description:   Initial Haskell Reflex skeleton for Flor do Mar.
build-type:    Simple
license:       BSD-3-Clause
author:        Flor do Mar contributors
maintainer:    Flor do Mar contributors
data-files:
  config/combat/physics.toml
  config/combat/boats/big.toml
  config/combat/boats/small.toml

common warnings
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wmissing-export-lists
    -Wpartial-fields
    -Wredundant-constraints

library
  import:           warnings
  autogen-modules:
    Paths_flor_do_mar
  exposed-modules:
    FlorDoMar.Combat
    FlorDoMar.Combat.Api
    FlorDoMar.Combat.Api.Local
    FlorDoMar.Combat.Config
    FlorDoMar.Combat.Domain
    FlorDoMar.Combat.Setup
  other-modules:
    Paths_flor_do_mar
  hs-source-dirs:   src
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.6 && <0.8,
    directory >=1.3 && <1.4,
    filepath >=1.4 && <1.6,
    text >=2.1 && <2.2

executable flor-do-mar-client
  import:          warnings
  main-is:         Main.hs
  other-modules:
    FlorDoMar.Client.BattleScene
    FlorDoMar.Client.BattleView
    FlorDoMar.Client.Render.Scene
    FlorDoMar.Client.WebGL.Camera
    FlorDoMar.Client.WebGL.Geometry
    FlorDoMar.Client.WebGL.Math
    FlorDoMar.Client.WebGL.Renderer
  hs-source-dirs:  app/client
  build-depends:
    base >=4.20 && <4.21,
    containers >=0.6 && <0.8,
    flor-do-mar,
    jsaddle >=0.9.9 && <0.10,
    jsaddle-warp >=0.9.9 && <0.10,
    linear >=1.23 && <1.24,
    reflex-dom-core >=0.8.1 && <0.9,
    text >=2.1 && <2.2,
    warp >=3.4 && <3.5,
    websockets >=0.13 && <0.14

test-suite combat-test
  import:          warnings
  type:            exitcode-stdio-1.0
  main-is:         CombatTest.hs
  hs-source-dirs:
    test
    app/client
  other-modules:
    FlorDoMar.Client.BattleScene
    FlorDoMar.Client.Render.Scene
    FlorDoMar.Client.WebGL.Camera
    FlorDoMar.Client.WebGL.Geometry
    FlorDoMar.Client.WebGL.Math
  build-depends:
    base >=4.20 && <4.21,
    flor-do-mar,
    linear >=1.23 && <1.24,
    text >=2.1 && <2.2
